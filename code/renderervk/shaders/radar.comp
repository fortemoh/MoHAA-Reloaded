#version 450

// radar.comp -- the Competitive HUD radar's picture for a storey's height (vk_radar.c: RE_RegisterRadar2D and
// RE_Radar2DHeight), made from each cell's floors as the UI's own picture is (RM_Paint in cl_uicomp.cpp), byte for
// byte, into the room buffer: the picture as its place in the 2D atlas holds it (its edge texels copied once around
// it, border 1; a texture of its own: border 0), which the renderer copies there.
//
// A cell (t x t texels; the picture's top row the map's north) shows its floor nearest the height, the first of
// equals in the list's order: its inside its shade, its sides with an edge a line, with a stair a stripe (on its
// left, right, top and bottom texels, an edge first at a corner), both brighter the nearer the floor is to the height
// (radar.glsl); no floor: clear. The whole picture: a thread a room texel. With CHANGING, a height's change from zOld
// to z: a thread a cell of those that can change (the list the UI made), writing only its texels that do.

#include "radar.glsl"

#ifdef CHANGING
layout( local_size_x = 64 ) in;
#else
layout( local_size_x = 8, local_size_y = 8 ) in;
#endif

// radar2D_t's memory as words: the cells' first floors (cw * ch + 1) at 0, the floors (radarFloor_t: z, fill, then
// alpha | sides << 8) at floorsWord, the changing cells at changingWord
layout( std430, set = 0, binding = 0 ) readonly buffer Floors {
	uint	words[];
} floors;

// the room's texels, RGBA8 a word, its rows w + 2 * border texels
layout( std430, set = 0, binding = 1 ) writeonly buffer Room {
	uint	texels[];
} room;

layout( push_constant ) uniform Push {
	uint	cw, ch, t;		// the cells across and down, a cell's texels across
	uint	floorsWord, changingWord, numChanging;
	uint	border;
	float	z, zOld;		// the height to paint for; the one painted before (CHANGING)
} p;

// the floor of [first, last) nearest z (the first of equals)
uint RM_Nearest( uint first, uint last, float z )
{
	uint best = first;

	for ( uint n = first + 1u; n < last; n++ ) {
		precise float dn = abs( uintBitsToFloat( floors.words[p.floorsWord + 3u * n] ) - z );
		precise float db = abs( uintBitsToFloat( floors.words[p.floorsWord + 3u * best] ) - z );

		if ( dn < db ) {
			best = n;
		}
	}
	return best;
}

// a floor's look for height z: its line's alpha, its stair's, its inside's, its sides
struct RM_Look {
	uint	line, stair, alpha, sides;
};

RM_Look RM_LookAt( uint n, float z )
{
	const float fz = uintBitsToFloat( floors.words[p.floorsWord + 3u * n] );
	const float fill = uintBitsToFloat( floors.words[p.floorsWord + 3u * n + 1u] );
	const uint packed = floors.words[p.floorsWord + 3u * n + 2u];
	const float focus = RM_Focus( fz, z );
	RM_Look l;

	l.line = RM_Line( focus );
	l.stair = RM_Stair( focus, fill );
	l.alpha = packed & 0xFFu;
	l.sides = ( packed >> 8 ) & 0xFFu;
	return l;
}

// the alpha of a cell's texel i, j (j down from its top row, the map's north up): on its left, right, top or bottom
// row that side's edge (a line) or stair (a stripe), an edge first (a corner on two sides, a cell a texel across on
// all four); else its inside
uint RM_Alpha( RM_Look l, uint i, uint j )
{
	const uint at = uint( i == 0u ) | uint( i == p.t - 1u ) << 1 | uint( j == 0u ) << 2 | uint( j == p.t - 1u ) << 3;

	return ( l.sides & at ) != 0u ? l.line : ( l.sides & at << 4 ) != 0u ? l.stair : l.alpha;
}

uint RM_Texel( uint alpha )
{
	return 235u | ( 240u << 8 ) | ( 245u << 16 ) | ( alpha << 24 );
}

#ifdef CHANGING

// picture texel x, y into the room, with its copies around the picture's edge
void RM_Store( uint x, uint y, uint value )
{
	const uint w = p.cw * p.t, h = p.ch * p.t, rowWidth = w + 2u * p.border;
	uint xs[3], ys[3], nx = 1u, ny = 1u;

	xs[0] = x + p.border;
	ys[0] = y + p.border;
	if ( p.border != 0u ) {
		if ( x == 0u ) {
			xs[nx++] = 0u;
		}
		if ( x == w - 1u ) {
			xs[nx++] = w + 1u;
		}
		if ( y == 0u ) {
			ys[ny++] = 0u;
		}
		if ( y == h - 1u ) {
			ys[ny++] = h + 1u;
		}
	}
	for ( uint b = 0u; b < ny; b++ ) {
		for ( uint a = 0u; a < nx; a++ ) {
			room.texels[ys[b] * rowWidth + xs[a]] = value;
		}
	}
}

void main()
{
	if ( gl_GlobalInvocationID.x >= p.numChanging ) {
		return;
	}

	const uint c = floors.words[p.changingWord + gl_GlobalInvocationID.x];
	const uint first = floors.words[c], last = floors.words[c + 1u];
	const RM_Look l = RM_LookAt( RM_Nearest( first, last, p.z ), p.z );
	const RM_Look was = RM_LookAt( RM_Nearest( first, last, p.zOld ), p.zOld );
	const uint x0 = c % p.cw * p.t, y0 = ( p.ch - 1u - c / p.cw ) * p.t;

	if ( l.alpha == was.alpha && l.sides == was.sides && ( ( l.sides & 15u ) == 0u || l.line == was.line )
		&& ( ( l.sides & 240u ) == 0u || l.stair == was.stair ) ) {
		return;	// (its texels the same)
	}
	for ( uint j = 0u; j < p.t; j++ ) {
		for ( uint i = 0u; i < p.t; i++ ) {
			const uint alpha = RM_Alpha( l, i, j );

			if ( alpha != RM_Alpha( was, i, j ) ) {
				RM_Store( x0 + i, y0 + j, RM_Texel( alpha ) );
			}
		}
	}
}

#else

void main()
{
	const uint w = p.cw * p.t, h = p.ch * p.t, rowWidth = w + 2u * p.border;
	const uint rx = gl_GlobalInvocationID.x, ry = gl_GlobalInvocationID.y;

	if ( rx >= rowWidth || ry >= h + 2u * p.border ) {
		return;
	}

	// (the room's edge: a copy of the picture's)
	const uint x = uint( clamp( int( rx ) - int( p.border ), 0, int( w ) - 1 ) );
	const uint y = uint( clamp( int( ry ) - int( p.border ), 0, int( h ) - 1 ) );
	const uint c = ( p.ch - 1u - y / p.t ) * p.cw + x / p.t;
	const uint first = floors.words[c], last = floors.words[c + 1u];

	room.texels[ry * rowWidth + rx] = first == last ? 0u : RM_Texel( RM_Alpha( RM_LookAt( RM_Nearest( first, last, p.z ), p.z ), x % p.t, y % p.t ) );
}

#endif
