menu "hud_comp_killer" 800 40 NONE 0
virtualres 1 1920 1080
drawcache 1
anchor 0.5 0.25
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "killer"
rect 0 0 800 40
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
textalign centerx
