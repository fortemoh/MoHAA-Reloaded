// The Competitive HUD (cg_hudstyle 1), CS2's corners (cg_hud_layout 2):
// bottom left, a cross and the health over a thin bar as wide as both that
// empties with it (all red at low health)
menu "hud_comp_cs2_health" 420 104 NONE 0
virtualres 1 1920 1080
drawcache 1
align left bottom
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "cross"
rect 32 36 22 22
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_health_on
shape in 0 0.333 1 0.667 fill 1 1 1 1
shape in 0.333 0 0.667 0.333 fill 1 1 1 1
shape in 0.333 0.667 0.667 1 fill 1 1 1 1
colorcvar ui_hud_health_col
}

resource
Label
{
name "health"
rect 62 19 80 56
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-36
textalign left
linkcvar ui_hud_health
colorcvar ui_hud_health_col
enabledcvar ui_hud_health_on
}

resource
Label
{
name "track"
rect 32 70 104 3
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_health_on
shape fill $ui_hud_acc 0.3
}

resource
Label
{
name "bar"
rect 32 70 104 3
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_health_on
shape fill 1 1 1 1
colorcvar ui_hud_health_col
widthcvar ui_hud_health_frac left
}

end.
