// The Competitive HUD (cg_hudstyle 1): bottom left, the chat and who last
// hurt you under it (who you follow: hud_comp_follow.urc); all higher with
// the health in the corner (CS:GO's, cg_hudstyle 1: ui_hud_corners)
menu "hud_comp_chat" 420 256 NONE 0
virtualres 1 1920 1080
drawcache 1
align left bottom
bgcolor 0 0 0 0
borderstyle NONE

// (never drawn: shown, the others move up)
resource
Label
{
name "corners"
rect 0 0 1 1
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_corners
}

resource
HudFeed
{
name "chat"
rect 25 0 360 160
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
enabledcvar cg_hud_chat
feed chat
moveif corners 0 -56
}

resource
Label
{
name "hurt"
rect 25 199 360 27
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-18s
textalign left
linkcvar ui_hud_hurt
colorcvar ui_hud_hurt_col
enabledcvar ui_hud_hurt_on
fitwidth 360
moveif corners 0 -56
}

end.
