// The Competitive HUD (cg_hudstyle 1): bottom left, the chat, who you
// follow and who last hurt you under it
menu "hud_comp_chat" 420 256 NONE 0
virtualres 1 1920 1080
drawcache 1
align left bottom
bgcolor 0 0 0 0
borderstyle NONE

resource
HudFeed
{
name "chat"
rect 25 0 360 160
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
feed chat
enabledcvar cg_hud_chat
}

resource
Label
{
name "follow"
rect 25 168 360 27
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-18s
textalign left
linkcvar ui_hud_follow
colorcvar ui_hud_follow_col
enabledcvar ui_hud_follow_on
}

resource
Label
{
name "hurt"
rect 25 199 360 27
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-18s
textalign left
linkcvar ui_hud_hurt
colorcvar ui_hud_hurt_col
enabledcvar ui_hud_hurt_on
}

end.
