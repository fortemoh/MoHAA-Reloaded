// The Competitive HUD (cg_hudstyle 1): top left, the compass (no radar),
// the game messages under the radar (hud_comp_topleft; moved down with its
// size, cg_hud_radar_size) or under the compass
menu "hud_comp_topleft_compass" 420 560 NONE 0
virtualres 1 1920 1080
drawcache 1
align left top
bgcolor 0 0 0 0
borderstyle NONE

// the compass (no radar): what the stock compass points at (the nearest
// teammate, or the objective) as a gold arrow on a ring, its distance and
// what it is inside, north a white triangle outside; the damage wedge
resource
Label
{
name "compass"
rect 29 29 112 112
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_compass_on
shape circle 0.047 0.055 0.071 0.45
shape ring 2 $ui_hud_acc_radar 0.6
}

resource
Label
{
name "compasswedge"
rect 29 29 112 112
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_compass_on
shape poly 0.753 0.188 0.129 1 0.5 0.38 0.64 0.02 0.36 0.02
rotatecvar ui_hud_dmg_angle
alphacvar ui_hud_dmg_alpha
}

resource
Label
{
name "matearrow"
rect 15 15 140 140
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_compass_on
shape poly 0 0 0 0.55 0.5 0.007 0.614 0.214 0.5 0.146 0.386 0.214
shape poly $ui_hud_acc 1 0.5 0.029 0.593 0.2 0.5 0.131 0.407 0.2
rotatecvar ui_hud_mate_angle
alphacvar ui_hud_mate_on
}

resource
Label
{
name "north"
rect 15 15 140 140
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_compass_on
shape poly 0 0 0 0.55 0.5 0 0.554 0.096 0.5 0.064 0.446 0.096
shape poly 1 1 1 1 0.5 0.007 0.543 0.086 0.5 0.054 0.457 0.086
rotatecvar ui_hud_north
}

resource
Label
{
name "matedist"
rect 29 60 112 38
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle NONE
font oswald-semibold-30s
textalign centerx
linkcvar ui_hud_mate
enabledcvar ui_hud_compass_on
alphacvar ui_hud_mate_on
}

resource
Label
{
name "matewhat"
rect 29 99 112 20
fgcolor 0.8 0.8 0.8 1
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-13s
textalign centerx
linkcvar ui_hud_mate_what
enabledcvar ui_hud_compass_on
alphacvar ui_hud_mate_on
}

// the game messages under the radar, or under the compass
resource
HudFeed
{
name "messages"
rect 25 289 360 120
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
boldfont oswald-semibold-16s
enabledcvar ui_hud_msgs_r
feed messages
}

resource
HudFeed
{
name "messagesc"
rect 25 201 360 120
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
boldfont oswald-semibold-16s
enabledcvar ui_hud_msgs_c
feed messages
}

end.
