// The Competitive HUD (cg_hudstyle 1): banners 70% of the way down, the
// wait for players and the spectator's keys: grey with yellow edges, as wide
// as their text
menu "hud_comp_banners" 1600 152 NONE 0
virtualres 1 1920 1080
drawcache 1
anchor 0.5 0.694
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "banner1"
rect 650 76 300 35
fgcolor 0.988 0.988 0.988 1
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-17s
textalign centerx
linkcvar ui_hud_banner1
enabledcvar ui_hud_banner1_on
shape fill 0.196 0.204 0.18 0.6
shape in 0 0 2px 1 fill 0.706 0.753 0.549 1
shape in -2px 0 1 1 fill 0.706 0.753 0.549 1
fittext 24 300 1536
fitwidth 1488
}

resource
Label
{
name "banner2"
rect 650 117 300 35
fgcolor 0.988 0.988 0.988 1
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-17s
textalign centerx
linkcvar ui_hud_banner2
enabledcvar ui_hud_banner2_on
shape fill 0.196 0.204 0.18 0.6
shape in 0 0 2px 1 fill 0.706 0.753 0.549 1
shape in -2px 0 1 1 fill 0.706 0.753 0.549 1
fittext 24 300 1536
fitwidth 1488
}

end.
