// The Competitive HUD (cg_hudstyle 1): the player you aim at, three quarters
// of the way down, with a health bar
menu "hud_comp_target" 400 35 NONE 0
virtualres 1 1920 1080
drawcache 1
anchor 0.5 0.75
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "target"
rect 0 0 400 24
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-16s
textalign centerx
linkcvar ui_hud_target
colorcvar ui_hud_target_col
enabledcvar ui_hud_target_on
fitwidth 400
}

resource
Label
{
name "targetbar"
rect 140 29 120 6
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_target_on
shape fill 0.047 0.055 0.071 0.78
}

resource
Label
{
name "targethealth"
rect 140 29 120 6
bgcolor 0 0 0 0
borderstyle NONE
colorcvar ui_hud_target_hpcol
enabledcvar ui_hud_target_on
widthcvar ui_hud_target_hp left
shape fill 1 1 1 1
}

resource
Label
{
name "targetframe"
rect 140 29 120 6
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_target_on
shape frame 1 1 1 1 0.102
}

end.
