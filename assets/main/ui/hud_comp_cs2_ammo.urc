// The Competitive HUD (cg_hudstyle 1), CS2's corners (cg_hud_layout 2):
// bottom right, under the weapons: a bullet leaning forward (/, the other
// way from the strip's), clip | reserve, the reserve on the weapons' right
// edge and each before the one after it
menu "hud_comp_cs2_ammo" 420 104 NONE 0
virtualres 1 1920 1080
drawcache 1
align right bottom
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "reserve"
rect 268 19 120 56
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-21
textalign right
linkcvar ui_hud_ammo
colorcvar ui_hud_acc
enabledcvar ui_hud_ammo_on
}

resource
Label
{
name "ammosep"
rect 0 37.5 2 19
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_ammo_on
shape fill $ui_hud_acc_line 0.6
flowbefore reserve 10
}

resource
Label
{
name "clip"
rect 0 19 120 56
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-36
textalign right
linkcvar ui_hud_clip
colorcvar ui_hud_acc
enabledcvar ui_hud_ammo_on
flowbefore ammosep 12
}

resource
Label
{
name "bullet"
rect 0 37 20 20
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_ammo_on
shape roundbox 2 $ui_hud_acc 1 6 20 45
flowbefore clip 12
}

end.
