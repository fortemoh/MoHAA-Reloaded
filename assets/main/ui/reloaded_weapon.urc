// The Reloaded weapon select, shown for SelectPrimaryWeapon and SelectPrimaryWeapon_<nation> (cl_uimenus.cpp); the model view of the menu's side beside the cards
menu "reloaded_weapon" 640 480 NONE 0
align left top
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle NONE
virtualres 1
drawcache 1

resource
ReloadedMenu
{
name "back"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
screen weapon
layer back
}

resource
Label
{
name "modelallies"
rect 0 0 64 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
linkcvar "ui_disp_playermodel"
rendermodel 1
modeloffset "0 0 0"
modelrotateoffset "0 0 0"
modelangles "10 180 0"
modelscale 1.12
modelanim americanselectionidle
}

resource
Label
{
name "modelaxis"
rect 0 0 64 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
linkcvar "ui_disp_playergermanmodel"
rendermodel 1
modeloffset "0 0 0"
modelrotateoffset "0 0 0"
modelangles "10 180 0"
modelscale 1.12
modelanim germanselectionidle
}

resource
ReloadedMenu
{
name "front"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
screen weapon
layer front
}

end.
