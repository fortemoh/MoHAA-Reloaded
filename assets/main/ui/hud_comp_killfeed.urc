// The Competitive HUD (cg_hudstyle 1): top right, the kill feed; under the
// players' cards where the screen has no room for both in a row
// (ui_hud_feed_under)
menu "hud_comp_killfeed" 445 233 NONE 0
virtualres 1 1920 1080
drawcache 1
align right top
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "under"
rect 0 0 1 1
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_feed_under
}

resource
HudFeed
{
name "kills"
rect 0 22 429 153
moveif under 0 48
bgcolor 0 0 0 0
borderstyle NONE
font oswald-semibold-15
enabledcvar cg_hud_killfeed
feed kills
}

end.
