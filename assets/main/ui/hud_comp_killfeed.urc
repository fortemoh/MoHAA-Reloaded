// The Competitive HUD (cg_hudstyle 1): top right, the kill feed
menu "hud_comp_killfeed" 445 185 NONE 0
virtualres 1 1920 1080
drawcache 1
align right top
bgcolor 0 0 0 0
borderstyle NONE

resource
HudFeed
{
name "kills"
rect 0 22 429 153
bgcolor 0 0 0 0
borderstyle NONE
font oswald-semibold-15
enabledcvar cg_hud_killfeed
feed kills
}

end.
