// The Competitive HUD (cg_hudstyle 1): top center, one dark box with the
// timer over the scores, Allies | Axis (self | the leader in free-for-all),
// a thin line between them; the players' cards either side in round modes
menu "hud_comp_score" 1920 80 NONE 0
virtualres 1 1920 1080
drawcache 1
align centerx top
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "box"
rect 914 0 92 64
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_score_on
shape fill 0.055 0.063 0.078 0.804
shape in 6px 35px -6px 36px fill 1 1 1 0.19
shape in 46px 40px 47px 59px fill 1 1 1 0.16
}

resource
Label
{
name "timer"
rect 914 2 92 38
bgcolor 0 0 0 0
borderstyle NONE
fgcolor 0.922 0.933 0.949 1
font oswald-semibold-28
textalign centerx
linkcvar ui_hud_timer
enabledcvar cg_hud_timer
}

resource
Label
{
name "scoreleft"
rect 914 38 46 28
bgcolor 0 0 0 0
borderstyle NONE
font oswald-semibold-24
textalign centerx
linkcvar ui_hud_score_l
colorcvar ui_hud_score_lc
enabledcvar ui_hud_score_on
}

resource
Label
{
name "scoreright"
rect 960 38 46 28
bgcolor 0 0 0 0
borderstyle NONE
font oswald-semibold-24
textalign centerx
linkcvar ui_hud_score_r
colorcvar ui_hud_score_rc
enabledcvar ui_hud_score_on
}

resource
HudCards
{
name "cardsallies"
rect 484 5 426 60
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-15s
team allies
icons iconallies iconaxis
enabledcvar ui_hud_vs_on
}

resource
HudCards
{
name "cardsaxis"
rect 1010 5 426 60
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-15s
team axis
icons iconallies iconaxis
enabledcvar ui_hud_vs_on
}

// the teams' icons (moh-icons team/allies.svg and team/axis.svg) the cards
// draw, in hidden widgets

resource
Label
{
name "iconallies"
rect 0 0 38 38
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_never
shape circle 0.102 0.118 0.231 1
shape poly 1 1 1 1 0.5 0 0.61226 0.34549 0.97553 0.34549 0.68164 0.55902 0.79389 0.90451 0.5 0.69098 0.20611 0.90451 0.31836 0.55902 0.02447 0.34549 0.38774 0.34549
shape circle 0.871 0 0 1 0.30902
}

resource
Label
{
name "iconaxis"
rect 0 0 38 38
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_never
shape circle 0.663 0.012 0.012 1
shape poly 1 1 1 1 0.28979 0.1 0.71021 0.1 0.61763 0.38237 0.9 0.28979 0.9 0.71021 0.61763 0.61763 0.71021 0.9 0.28979 0.9 0.38237 0.61763 0.1 0.71021 0.1 0.28979 0.38237 0.38237
shape poly 0 0 0 1 0.345 0.14 0.655 0.14 0.555 0.445 0.86 0.345 0.86 0.655 0.555 0.555 0.655 0.86 0.345 0.86 0.445 0.555 0.14 0.655 0.14 0.345 0.445 0.445
}

end.
