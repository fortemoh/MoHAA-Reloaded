// The Competitive HUD (cg_hudstyle 1): top center, Allies | timer | Axis
// (self | timer | the leader in free-for-all) on a blue panel fading down,
// "N vs M" alive under it in round modes, the players' cards either side.
// Two layouts: with the other team's score (ui_hud_p3), and narrower
// without it, before a scoreboard tells it
menu "hud_comp_score" 1920 80 NONE 0
virtualres 1 1920 1080
drawcache 1
align centerx top
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "panel3"
rect 885 0 150 77
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_score_on&ui_hud_vs_on&ui_hud_p3
shape vgradient 0 0.62 0.212 0.376 0.494 0.902 0.259 0.424 0.565 0.702
shape vgradient 0.62 1 0.259 0.424 0.565 0.702 0.282 0.471 0.612 0
}

resource
Label
{
name "panelshort3"
rect 885 0 150 44
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_score_on&!ui_hud_vs_on&ui_hud_p3
shape vgradient 0 0.62 0.212 0.376 0.494 0.902 0.259 0.424 0.565 0.702
shape vgradient 0.62 1 0.259 0.424 0.565 0.702 0.282 0.471 0.612 0
}

resource
Label
{
name "scoreleft3"
rect 885 0 48 44
bgcolor 0 0 0 0
borderstyle NONE
font oswald-medium-22s
textalign centerx
linkcvar ui_hud_score_l
colorcvar ui_hud_score_lc
enabledcvar ui_hud_score_on&ui_hud_p3
}

resource
Label
{
name "timer3"
rect 933 0 54 44
bgcolor 0 0 0 0
borderstyle NONE
fgcolor 0.988 0.988 0.988 1
font oswald-medium-22s
textalign centerx
linkcvar ui_hud_timer
enabledcvar cg_hud_timer&ui_hud_p3
}

